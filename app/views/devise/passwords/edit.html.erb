<div class="auth-container mx-auto">
  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <h1 class="h4 mb-4 text-center"><%= t('.change_your_password') %></h1>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="mb-3">
          <%= f.label :password, t('.new_password'), class: "form-label" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control",
                aria: { describedby: ("password_help" if @minimum_password_length) } %>
          <% if @minimum_password_length %>
            <div id="password_help" class="form-text"><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></div>
          <% end %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, t('.confirm_new_password'), class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        </div>

        <div class="d-grid">
          <%= f.submit t('.change_my_password'), class: "btn btn-primary" %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
