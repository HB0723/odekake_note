<section class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3">
    <h2 class="h5 mb-0">持ち物</h2>
    <%= link_to "＋ 持ち物を追加", new_outing_packing_item_path(outing), class: "btn btn-sm btn-outline-primary" %>
  </div>

  <%= render "packing_items/summary", outing: outing %>

  <% if outing.packing_items.blank? %>
    <p class="text-body-secondary small px-3 pb-3 mb-0">持ち物はまだありません。</p>
  <% else %>
    <ul class="list-group list-group-flush">
      <% outing.packing_items.ordered.each do |packing_item| %>
        <%= render "packing_items/item", outing: outing, packing_item: packing_item %>
      <% end %>
    </ul>
  <% end %>
</section>
