<%= form_with(model: [ outing, packing_item ]) do |form| %>
  <%= render "shared/form_errors", record: packing_item %>

  <div class="mb-4">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "例: 折りたたみ傘" %>
  </div>

  <%= render "shared/form_actions", form: form, cancel_path: outing_path(outing) %>
<% end %>
