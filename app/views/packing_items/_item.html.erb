<%# チェック状態の切り替え時に Turbo Stream でこの行ごと差し替える（li の id を変えないこと） %>
<li id="<%= dom_id packing_item %>" class="list-group-item d-flex align-items-center gap-2 py-1">
  <%= form_with url: toggle_outing_packing_item_path(outing, packing_item), method: :patch,
        class: "flex-grow-1 min-w-0", data: { controller: "auto-submit" } do %>
    <%# 名前（label）をタップしてもチェックできるよう、行の大部分をタップ範囲にする %>
    <div class="form-check d-flex align-items-center gap-3 ps-0 mb-0">
      <%= check_box_tag :checked, "1", packing_item.checked,
            id: dom_id(packing_item, :checked),
            class: "form-check-input packing-check flex-shrink-0 m-0",
            data: { action: "change->auto-submit#submit" } %>
      <%= label_tag dom_id(packing_item, :checked), packing_item.title,
            class: "form-check-label flex-grow-1 text-break py-2 #{"text-decoration-line-through text-body-secondary" if packing_item.checked?}" %>
    </div>
  <% end %>

  <div class="d-flex flex-shrink-0 gap-1">
    <%= link_to "編集", edit_outing_packing_item_path(outing, packing_item), class: "btn btn-sm btn-link link-secondary" %>
    <%= button_to "削除", outing_packing_item_path(outing, packing_item), method: :delete,
          class: "btn btn-sm btn-link link-danger",
          form: { data: { turbo_confirm: "この持ち物を削除しますか？" } } %>
  </div>
</li>
