<%= form_with(model: [ outing, schedule_item ]) do |form| %>
  <% if schedule_item.errors.any? %>
    <div style="color: red">
      <h2><%= schedule_item.errors.count %>件のエラーがあるため保存できませんでした。</h2>

      <ul>
        <% schedule_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 日帰りのときは1日目固定なので選択欄を出さない %>
  <% if outing.day_count > 1 %>
    <div>
      <%= form.label :day_number, style: "display: block" %>
      <%= form.select :day_number, day_options(outing) %>
    </div>
  <% end %>

  <div>
    <%= form.label :starts_at, style: "display: block" %>
    <%= form.time_field :starts_at %>
    <small>空欄なら時間未定として、その日の最後に表示します</small>
  </div>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :memo, style: "display: block" %>
    <%= form.textarea :memo %>
  </div>

  <div>
    <%= form.submit "保存する" %>
  </div>
<% end %>
