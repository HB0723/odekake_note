<%= form_with(model: [ outing, schedule_item ]) do |form| %>
  <%= render "shared/form_errors", record: schedule_item %>

  <div class="row g-3 mb-3">
    <%# 日帰りのときは1日目固定なので選択欄を出さない %>
    <% if outing.day_count > 1 %>
      <div class="col-sm-6">
        <%= form.label :day_number, class: "form-label" %>
        <%= form.select :day_number, day_options(outing), {}, class: "form-select" %>
      </div>
    <% end %>

    <div class="col-sm-6">
      <%= form.label :starts_at, class: "form-label" %>
      <%= form.time_field :starts_at, class: "form-control", aria: { describedby: "starts_at_help" } %>
      <div id="starts_at_help" class="form-text">空欄なら時間未定として、その日の最後に表示します</div>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "例: 鶴岡八幡宮" %>
  </div>

  <div class="mb-4">
    <%= form.label :memo, class: "form-label" %>
    <%= form.textarea :memo, class: "form-control", rows: 3 %>
  </div>

  <%= render "shared/form_actions", form: form, cancel_path: outing_path(outing) %>
<% end %>
