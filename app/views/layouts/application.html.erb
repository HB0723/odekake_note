<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Odekake Note" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Odekake Note">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Bootstrap は CDN から読み込む。バージョン固定＋integrity で改ざんされたファイルは読み込まない %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous" defer></script>

    <%# Includes all stylesheet files in app/assets/stylesheets（Bootstrap より後に読み込んで上書きする） %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-4">
      <div class="container app-main">
        <%= link_to "Odekake Note", root_path, class: "navbar-brand" %>

        <% if user_signed_in? %>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu"
                  aria-controls="navbar-menu" aria-expanded="false" aria-label="メニューを開く">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div class="collapse navbar-collapse justify-content-end" id="navbar-menu">
            <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 py-2 py-sm-0">
              <% if current_user.guest? %>
                <span class="badge rounded-pill text-bg-light align-self-start align-self-sm-center">ゲストとしてログイン中</span>
              <% else %>
                <%= link_to current_user.email, edit_user_registration_path, class: "nav-link text-white text-truncate" %>
              <% end %>
              <%= button_to "ログアウト", destroy_user_session_path, method: :delete,
                    class: "btn btn-outline-light btn-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    </nav>

    <main class="container app-main pb-5">
      <% if notice.present? %>
        <div class="alert alert-primary alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="閉じる"></button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="閉じる"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
