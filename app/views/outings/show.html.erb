<% content_for :title, @outing.title %>

<p class="mb-2">
  <%= link_to "← おでかけ一覧", outings_path, class: "link-secondary text-decoration-none small" %>
</p>

<%= render @outing %>

<%= render "schedule_items/list", outing: @outing %>

<%= render "packing_items/list", outing: @outing %>

<div class="d-flex flex-wrap gap-2 mt-4">
  <%= link_to "おでかけを編集", edit_outing_path(@outing), class: "btn btn-outline-secondary" %>
  <%= button_to "おでかけを削除", @outing, method: :delete, class: "btn btn-outline-danger",
        form: { data: { turbo_confirm: "このおでかけを削除しますか？" } } %>
</div>
