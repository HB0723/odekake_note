<% content_for :title, "おでかけ一覧" %>

<h1>おでかけ一覧</h1>

<div id="outings">
  <% if @outings.empty? %>
    <p>まだおでかけがありません。「新しいおでかけ」から登録してみましょう。</p>
  <% end %>

  <% @outings.each do |outing| %>
    <%= render outing %>
    <p>
      <%= link_to "詳細を見る", outing %>
    </p>
  <% end %>
</div>

<%= link_to "新しいおでかけ", new_outing_path %>
