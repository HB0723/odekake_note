<%= form_with(model: outing) do |form| %>
  <%= render "shared/form_errors", record: outing %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "例: 鎌倉日帰り散歩" %>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-sm-6">
      <%= form.label :start_on, class: "form-label" %>
      <%= form.date_field :start_on, class: "form-control" %>
    </div>
    <div class="col-sm-6">
      <%= form.label :end_on, class: "form-label" %>
      <%= form.date_field :end_on, class: "form-control", aria: { describedby: "end_on_help" } %>
      <div id="end_on_help" class="form-text">空欄なら日帰りとして扱います</div>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :place, class: "form-label" %>
    <%= form.text_field :place, class: "form-control" %>
  </div>

  <div class="mb-4">
    <%= form.label :memo, class: "form-label" %>
    <%= form.textarea :memo, class: "form-control", rows: 3 %>
  </div>

  <%= render "shared/form_actions", form: form, cancel_path: cancel_path %>
<% end %>
